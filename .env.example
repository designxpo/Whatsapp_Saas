# ── Alabs Connect (SaaS) — environment ──────────────────────────────────────
# Copy to .env.local and fill in. NEVER commit .env.local.
#
# This is the MULTI-TENANT SaaS. Its infrastructure is SEPARATE from the
# internal wa-broadcaster app: its own Supabase project, its own Meta app
# (a Tech Provider app), its own keys. Per-tenant credentials (each customer's
# WhatsApp number/token, their CRM keys) are NOT set here — they are collected
# via Embedded Signup / settings and stored ENCRYPTED per tenant (crypto.ts).

# --- Meta app (Tech Provider — onboards each tenant's OWN WABA) ---
# One platform-level app; tenants connect their own numbers through Embedded
# Signup. Do NOT put a single tenant's WABA token here.
META_APP_ID=                          # [REQUIRED] Meta app id (Tech Provider app)
META_APP_SECRET=                      # [REQUIRED] Meta app secret — verifies webhook signatures (X-Hub-Signature-256)
META_EMBEDDED_SIGNUP_CONFIG_ID=       # [REQUIRED] Embedded Signup configuration id (Meta → app → WhatsApp → Embedded Signup)
META_WEBHOOK_VERIFY_TOKEN=            # [REQUIRED] any random string; paste the same value in Meta webhook config
META_GRAPH_VERSION=v22.0              # Graph API version

# Embedded Signup (client-side popup) — public, safe to expose. Set once the app
# is an approved Tech Provider and the signup configurations exist. When unset,
# the portal hides the "Connect with Facebook" buttons (manual entry still works).
NEXT_PUBLIC_META_APP_ID=                       # same as META_APP_ID (public)
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=    # WhatsApp Embedded Signup config id
NEXT_PUBLIC_META_INSTAGRAM_CONFIG_ID=          # Instagram Embedded Signup config id

# ── Business Login for Instagram ──────────────────────────────────────────────
# A DIFFERENT Meta product from Facebook Login for Business, with its own app id
# and secret. The instagram_business_* permissions exist only here — they cannot
# be selected in a Facebook Login configuration at all. App Dashboard →
# Instagram → API setup with Instagram login.
META_INSTAGRAM_APP_ID=                         # "Instagram app ID" on that page (NOT META_APP_ID)
META_INSTAGRAM_APP_SECRET=                     # "Instagram app secret" on that page
# Optional. Must match the whitelisted OAuth redirect URI byte-for-byte; derived
# from the request origin when unset.
META_INSTAGRAM_REDIRECT_URI=
# Optional. Defaults to basic + manage_messages + manage_comments. A scope the
# app isn't approved for makes Instagram reject the whole authorize, so this
# exists to drop one without a deploy.
META_INSTAGRAM_SCOPES=
NEXT_PUBLIC_META_MESSENGER_CONFIG_ID=          # Facebook Page (Messenger) Login for Business config id
NEXT_PUBLIC_META_ADS_CONFIG_ID=                # Meta Ads Login for Business config id (ads_management + ads_read, Ad account asset)
NEXT_PUBLIC_META_GRAPH_VERSION=v22.0

# Per-number daily cap, per rolling 24h. The EFFECTIVE cap is derived from each
# number's real Meta messaging tier: cap = WA_SAFETY_PCT% of the tier (e.g.
# TIER_1K → 1000 × 80% = 800). WA_DAILY_LIMIT is only the FALLBACK when the tier
# can't be read.
WA_DAILY_LIMIT=900
NEXT_PUBLIC_WA_DAILY_LIMIT=900
WA_SAFETY_PCT=80                      # % of the Meta tier we actually send (kept low for safety)
# WA_DAILY_LIMIT_MAX=2000            # optional hard ceiling regardless of tier (unset = none)
WA_SEND_CHUNK=80                      # recipients attempted per cron tick / inline chunk
WA_DRAIN_CONCURRENCY=5               # campaigns drained concurrently per cron run (atomic SKIP-LOCKED claims)

# --- AI Assistant (Google Gemini + RAG) — platform-level key ---
GEMINI_API_KEY=                       # [REQUIRED for AI] Google AI Studio key (aistudio.google.com/apikey)
GEMINI_CHAT_MODEL=gemini-2.5-flash    # reply generation model
GEMINI_EMBED_MODEL=gemini-embedding-001  # embedding model (dim must match vector(768) in 0003_kb.sql)
LLM_BOT_ENABLED=true                  # global kill switch — 'false' stops all auto-replies
KNOWLEDGE_ROUTER_ENABLED=true         # FAQ/cache/memory router before RAG — 'false' = always RAG

# --- Auth & secrets ---
ADMIN_USER=                           # [REQUIRED] platform owner login (default-tenant admin)
ADMIN_PASSWORD=                       # [REQUIRED] strong password (20+ chars)
ADMIN_JWT_SECRET=                     # [REQUIRED] 32+ char random string; signs session JWTs AND email unsubscribe links. Rotating it invalidates unsubscribe links already sitting in inboxes — those fall back to a mailto:, so nobody is stranded, but expect a few manual opt-out requests after a rotation.
SECRET_ENC_KEY=                       # [REQUIRED] 32+ char high-entropy key; encrypts per-tenant secrets at rest (AES-256-GCM)
BROADCAST_API_KEY=                    # [REQUIRED] Bearer token for server-to-server /api/broadcast + /api/contacts + /api/events
CRON_SECRET=                          # [REQUIRED] Bearer token guarding /api/cron/*

# --- Email OTP (login 2FA on new devices + signup email verification) ---
RESEND_API_KEY=                       # [REQUIRED for OTP] resend.com API key — create an account, verify a sending domain, then generate a key
RESEND_FROM_EMAIL=                    # e.g. "Talko AI <no-reply@thetalko.in>" — must be on a domain verified in Resend; defaults to no-reply@thetalko.in
OTP_HASH_SECRET=                      # peppers BOTH WhatsApp and email OTP hashes; any random string. Legacy name OTP_API_SECRET also read.
RESEND_WEBHOOK_SECRET=                # [optional, powers Owner Console → Emails' delivered/opened/clicked/bounced status] Resend dashboard → Webhooks → add endpoint https://<domain>/api/webhooks/resend, events: sent/delivered/delivery_delayed/opened/clicked/bounced/complained/failed — copy the signing secret it shows you (starts "whsec_")
LOGIN_OTP_EXEMPT_EMAILS=              # comma-separated emails that skip the new-device OTP entirely — e.g. a Meta App Review reviewer test login with no one present to relay an emailed code. Leave unset in normal operation.

# --- Supabase (DEDICATED SaaS project — NOT the internal app's project) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_KEY=                 # service-role/secret key (server-only; bypasses RLS — app-layer tdb() is the guard)

# --- Content safety layer (src/lib/moderation.ts) ---
# Screens every outbound AI reply, public comment/DM/review reply, and uploaded
# image against Meta's and Google's content policies before it can reach a
# customer or post under the shared Tech Provider app.
#
# An OpenAI API key, used ONLY for the free omni-moderation-latest endpoint.
# Deliberately platform-level and separate from each tenant's bring-your-own AI
# key: public replies go out under OUR Meta/Google app, so one tenant must not
# be able to disable this by removing their own key. Also means the check still
# runs when a tenant picked Gemini or Anthropic for replies.
#
# UNSET = the hosted check is inert (the local keyword pre-filter still runs, so
# protection is never zero). Set this in production.
MODERATION_API_KEY=
#
# KNOWN GAP: the moderation model scores text and IMAGES only. Uploaded VIDEO
# is not content-scanned — only MIME/size validated. Meta/Google review ad and
# template video themselves, but in-chat video is unscreened; treat that as an
# open item, not a solved one.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://app.your-saas-domain.com

# Dogfooding: puts Talko AI's own website-chat widget on the marketing site,
# the same embed a customer pastes into their own site. Create a "webchat"
# channel for your own company in the portal (Settings → Website chat →
# New widget), copy its site key, and set it here. Leave unset to keep the
# widget off — nothing renders without it.
NEXT_PUBLIC_MARKETING_WEBCHAT_SITE_KEY=

# ── Google Analytics 4 ───────────────────────────────────────────────────────
# Measurement ID from Admin → Data Streams → your web stream. Leave EMPTY to
# disable the tag entirely (the normal state in development — an unset value
# means no script is injected and every track() call is a no-op).
#
# Scope: marketing pages + /signup only. Never the /admin portal.
# REQUIRED in the GA4 UI, not here: the stream's "Configure tag settings →
# Configure your domains" must list BOTH thetalko.in and app.thetalko.in,
# because /signup is served on the app host. Without it GA4 records every
# conversion as a self-referral and the real acquisition source is lost.
NEXT_PUBLIC_GA_ID=

# NOTE — per-tenant integrations (NOT global env):
#   * Each tenant's WhatsApp number + access token  → Embedded Signup → encrypted vault
#   * Each tenant's CRM (LeadSquared, etc.) keys     → tenant settings → encrypted vault
#   The internal app's META_WA_* and LSQ_*/CRM_* env vars are intentionally
#   removed here — they were a single hardcoded tenant.

# --- Payment webhooks (in-chat order confirmation) ---
# Confirms in-chat orders when the hosted pay link is paid. NOTE the payment
# providers themselves (Razorpay/Stripe keys) are PER-TENANT in the encrypted
# vault, so these platform-level webhook secrets cover the PRIMARY account only.
# Full multi-tenant support needs per-tenant webhook URLs + secrets (see
# COMMERCE-CHECKOUT-FLOW.md — Phase 2).
RAZORPAY_WEBHOOK_SECRET=              # Razorpay Dashboard → Webhooks (event: payment_link.paid) → /api/webhooks/razorpay
STRIPE_WEBHOOK_SECRET=               # Stripe webhook signing secret (whsec_…) — subscriptions + order pay-links → /api/webhooks/stripe

# --- Our own GST identity on billing documents (src/lib/supplier-identity.ts) ---
# WHO WE ARE as the supplier on an Indian GST tax invoice. There are NO defaults
# for any of these: until the four marked [REQUIRED for Tax Invoice] are all set,
# every billing document we issue is labelled "Payment Receipt" instead of
# "Tax Invoice", and customers CANNOT claim input tax credit against it. That is
# the correct state for an unregistered supplier — a document saying "Tax
# Invoice" over a blank or guessed GSTIN is not.
TALKO_GSTIN=                          # [REQUIRED for Tax Invoice] our 15-char GSTIN. A malformed value is treated as unset (and logged) rather than printed
TALKO_STATE_CODE=                     # [REQUIRED for Tax Invoice] 2-digit GST state code of our registration (e.g. 07 = Delhi). Decides CGST+SGST vs IGST; must match the first 2 chars of TALKO_GSTIN
TALKO_SAC_CODE=                       # [REQUIRED for Tax Invoice] SAC of the supply (Rule 46(f)) — confirm with your CA; do NOT guess, it classifies every invoice we ever issue
TALKO_ADDRESS_LINES=                  # [REQUIRED for Tax Invoice] registered address, pipe-separated for multiple lines: "Line 1|Line 2|New Delhi 110001"
TALKO_LEGAL_NAME=                     # registered legal name. Defaults to LEGAL_META.legalEntity from src/app/(site)/_content/legal.ts
TALKO_STATE=                          # state name printed on the document (e.g. Delhi). Display only — TALKO_STATE_CODE is what the tax split uses
TALKO_SIGNATORY=                      # name printed against "Authorised Signatory". Omitted from the document when unset
TALKO_CIN=                            # company identification number, if we are a registered company
TALKO_PAN=                            # PAN, if it should appear on the document

# --- Google OAuth (YouTube comment automation + Google Reviews) ---
# One Google Cloud OAuth client covers both features. Create it under APIs &
# Services → Credentials → OAuth client ID (Web application), with the
# YouTube Data API v3 enabled and the youtube.force-ssl scope on the consent
# screen. Register redirect URIs for the OAuth Playground (manual token
# minting / testing) and https://<app-host>/api/admin/onboarding/youtube/callback.
GOOGLE_OAUTH_CLIENT_ID=                # [REQUIRED for YouTube] ends in .apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=            # [REQUIRED for YouTube] starts with GOCSPX-
