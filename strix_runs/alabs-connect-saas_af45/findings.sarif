                  "snippet": {
                    "text": "? <a key={i} href={part} target=\"_blank\" rel=\"noreferrer\" className=\"underline decoration-1 underline-offset-2 break-all hover:opacity-80\">{part}</a>"
                  }
                }
              },
              "message": {
                "text": "Vulnerable `href` attribute construction"
