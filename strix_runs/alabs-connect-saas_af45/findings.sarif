            {
              "id": "CWE-834",
              "name": "next: Next.js: Denial of Service via crafted requests to App Router with Server Actions",
              "shortDescription": {
                "text": "next: Next.js: Denial of Service via crafted requests to App Router with Server Actions"
              },
              "fullDescription": {
                "text": "Next.js is a React framework for building full-stack web applications. In versions 13.0.0 through 15.5.20 and 16.0.0 through 16.2.10, crafted requests targeting Next.js applications using App Router with at least one Server Action can lead to excessive CPU usage blocking processing of further requests in the same process. This issue has been fixed in versions 15.5.21 and 16.2.11."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "help": {
                "text": "Next.js is a React framework for building full-stack web applications. In versions 13.0.0 through 15.5.20 and 16.0.0 through 16.2.10, crafted requests targeting Next.js applications using App Router with at least one Server Action can lead to excessive CPU usage blocking processing of further requests in the same process. This issue has been fixed in versions 15.5.21 and 16.2.11.\n\nThe vulnerability in `next` can lead to high impact.\n\nUpgrade `next` to version `15.5.21, 16.2.11` or higher.",
                "markdown": "Next.js is a React framework for building full-stack web applications. In versions 13.0.0 through 15.5.20 and 16.0.0 through 16.2.10, crafted requests targeting Next.js applications using App Router with at least one Server Action can lead to excessive CPU usage blocking processing of further requests in the same process. This issue has been fixed in versions 15.5.21 and 16.2.11.\n\nThe vulnerability in `next` can lead to high impact.\n\nUpgrade `next` to version `15.5.21, 16.2.11` or higher."
              },
              "properties": {
